{
 "AbstractTriad": {
  "pattern": "\\b(?:[a-z-]+(?:ity|ness|tion|sion|ance|ence|ism|ship|ility)|trust|rigor|clarity|calm|craft|care|focus|discipline|taste|speed|scale|intent|judgment|courage|candor|warmth|depth|proof),\\s+(?:[a-z-]+(?:ity|ness|tion|sion|ance|ence|ism|ship|ility)|trust|rigor|clarity|calm|craft|care|focus|discipline|taste|speed|scale|intent|judgment|courage|candor|warmth|depth|proof),?\\s+and\\s+(?:[a-z-]+(?:ity|ness|tion|sion|ance|ence|ism|ship|ility)|trust|rigor|clarity|calm|craft|care|focus|discipline|taste|speed|scale|intent|judgment|courage|candor|warmth|depth|proof)\\b",
  "ignorecase": true
 },
 "Adverb": {
  "pattern": "\\b(?:quietly|simply|actually|really|very|basically|literally|structurally|precisely|exactly|merely|truly|clearly|obviously|essentially|virtually|generally|currently|quickly|easily|just|seamlessly|robustly|arguably|somewhat|fairly|seemingly|notably|importantly|honestly|frankly|candidly|genuinely|carefully|thoughtfully|properly|effortlessly|cleanly|transparently|authentically)\\b",
  "ignorecase": true
 },
 "Cliche": {
  "pattern": "\\b(?:game[ -]changer|at the end of the day|in a nutshell|low-hanging fruit|move the needle|paradigm shift|thought leader|best-in-class|cutting-edge|state-of-the-art|tip of the iceberg|win-win|secret sauce|double-edged sword|perfect storm|in today['\u2019]?s fast-paced world|in the ever-evolving landscape)\\b",
  "ignorecase": true
 },
 "CodeToken": {
  "pattern": "\\b[A-Z][A-Z0-9]{2,}(?:_[A-Z0-9]+)+\\b|\\b[A-Z]\\s*[\u00d7x*]\\s*[A-Z]\\b",
  "ignorecase": false
 },
 "CopulaInflation": {
  "pattern": "\\b(?:serves as an?|serves as the|stands as an?|(?:is|are) a testament to|marks a significant|represents a significant|boasts an?)\\b",
  "ignorecase": true
 },
 "Dash": {
  "pattern": "(?:\u2014|\u2013)",
  "ignorecase": false
 },
 "EpigramContrast": {
  "pattern": "\\b(?:is|are|was|were|reads?\\s+as|stays?|remains?|becomes?)\\s+(?:a\\s+|an\\s+|the\\s+)?[\\w\u2019'-]+(?:\\s+[\\w\u2019'-]+){0,2},\\s+not\\s+(?:a\\s+|an\\s+|the\\s+)?[\\w\u2019'-]+",
  "ignorecase": true
 },
 "FilePath": {
  "pattern": "\\b[\\w.-]+/[\\w./-]*\\.(?:md|html?|py|json|pptx|docx|xlsx|csv|txt|js|pdf)\\b|\\b\\d{2}_[a-z_]+/|\\b[\\w-]{3,}\\.(?:md|py|json|pptx|docx|xlsx)\\b",
  "ignorecase": true
 },
 "HiddenVerb": {
  "pattern": "\\b(?:conduct|perform|provide|make|undertake|engage in|carry out)\\s+(?:a|an|the)?\\s*\\w+(?:tion|sion|ment|ance|sis)\\b",
  "ignorecase": true
 },
 "LinkText": {
  "pattern": "\\b(?:click here|read more|this (?:document|article|page|link))\\b",
  "ignorecase": true
 },
 "NegParallel": {
  "pattern": "\\bnot\\s+(?:just|only|merely)\\b[^.!?]{0,80}\\b(?:but|it['\u2019]?s)\\b|\\bit['\u2019]?s\\s+not\\b[^.!?]{0,60},\\s*it['\u2019]?s\\b|\\bisn['\u2019]?t\\s+(?:just|only)\\b[^.!?]{0,60}\\bit['\u2019]?s\\b",
  "ignorecase": true
 },
 "NeverTag": {
  "pattern": ",\\s+never\\s+(?:a\\s+|an\\s+|the\\s+|as\\s+)?(?:[^t\\s][\\w\u2019'-]*|t[^o\\s][\\w\u2019'-]*|to[\\w\u2019'-]+)(?:\\s+[\\w\u2019'-]+){0,3}",
  "ignorecase": false
 },
 "Passive": {
  "pattern": "\\b(?:is|are|was|were|be|been|being)\\s+(?:\\w+ly\\s+)?(?:\\w+ed|done|made|given|taken|shown|known|seen|held|kept|built|sent|found)\\b",
  "ignorecase": true
 },
 "SectionCode": {
  "pattern": "(?:\u00a7|\\bsec(?:tion)?\\.?\\s?)\\s?\\d+|[\\[(]S\\d{1,3}[\\])]",
  "ignorecase": true
 },
 "StatusBracket": {
  "pattern": "\\[[^\\]]{0,60}(?:GREEN|AMBER|RED)[^\\]]{0,15}\\]",
  "ignorecase": true
 },
 "VirtueHonest": {
  "pattern": "\\bhonest\\s+(?:update|read|take|answer|assessment|truth|conversation|look|appraisal|opinion|reflection|reaction|note|word)\\b|\\b(?:to be|being|let me be|i['\u2019]?ll be|if i['\u2019]?m being)\\s+honest\\b|\\bin all honesty\\b|\\bhonestly\\s+speaking\\b",
  "ignorecase": true
 },
 "WeakResume": {
  "pattern": "\\b(?:responsible for|duties included|worked on|involved in|helped to|in charge of|tasked with|own(?:ed|s)? (?:the )?product vision)\\b",
  "ignorecase": true
 }
}