// Card-style flow infographic for humanize. Copy it, rename the stages and badges, keep the styling.
// Render: dot -Tpng -Gdpi=170 card-diagram.dot -o figure-N.png, then look at the PNG.
// Badge text stays within about 4 words; the caption explains each numbered marker.
digraph G {
  graph [rankdir=LR, bgcolor="#fcfcfb", pad=0.3, nodesep=0.5, ranksep=0.9, fontname="Liberation Sans", labelloc=b, label=<<TABLE BORDER="0" CELLSPACING="8" CELLPADDING="5">
      <TR>
        <TD BGCOLOR="#e3eefb" STYLE="rounded"><FONT POINT-SIZE="12" COLOR="#0b0b0b">  status one  </FONT></TD>
        <TD BGCOLOR="#fdf1d6" STYLE="rounded"><FONT POINT-SIZE="12" COLOR="#0b0b0b">  status two  </FONT></TD>
      </TR>
    </TABLE>>];
  node  [shape=plain, fontname="Liberation Sans"];
  edge  [color="#8a8984", penwidth=2, arrowsize=0.9, fontname="Liberation Sans", fontsize=13, fontcolor="#52514e"];

  a [label=<
    <TABLE BORDER="1" COLOR="#2a78d6" CELLBORDER="0" CELLSPACING="6" CELLPADDING="7" STYLE="rounded" BGCOLOR="white">
      <TR><TD BGCOLOR="#2a78d6" STYLE="rounded"><FONT COLOR="white" POINT-SIZE="18"><B>Stage A</B></FONT></TD></TR>
      <TR><TD BGCOLOR="#e3eefb" STYLE="rounded" ALIGN="LEFT"><FONT POINT-SIZE="14" COLOR="#0b0b0b">&#9312;  Short label</FONT></TD></TR>
      <TR><TD BGCOLOR="#e3eefb" STYLE="rounded" ALIGN="LEFT"><FONT POINT-SIZE="14" COLOR="#0b0b0b">&#9313;  Short label</FONT></TD></TR>
      <TR><TD BGCOLOR="#e3eefb" STYLE="rounded" ALIGN="LEFT"><FONT POINT-SIZE="14" COLOR="#0b0b0b">&#9314;  Short label</FONT></TD></TR>
    </TABLE>>];

  b [label=<
    <TABLE BORDER="1" COLOR="#eb6834" CELLBORDER="0" CELLSPACING="6" CELLPADDING="7" STYLE="rounded" BGCOLOR="white">
      <TR><TD BGCOLOR="#eb6834" STYLE="rounded"><FONT COLOR="white" POINT-SIZE="18"><B>Stage B</B></FONT></TD></TR>
      <TR><TD BGCOLOR="#fdf1d6" STYLE="rounded" ALIGN="LEFT"><FONT POINT-SIZE="14" COLOR="#0b0b0b">&#9315;  Short label</FONT></TD></TR>
      <TR><TD BGCOLOR="#fdf1d6" STYLE="rounded" ALIGN="LEFT"><FONT POINT-SIZE="14" COLOR="#0b0b0b">&#9316;  Short label</FONT></TD></TR>
    </TABLE>>];

  c [label=<
    <TABLE BORDER="1" COLOR="#52514e" CELLBORDER="0" CELLSPACING="6" CELLPADDING="7" STYLE="rounded" BGCOLOR="white">
      <TR><TD BGCOLOR="#52514e" STYLE="rounded"><FONT COLOR="white" POINT-SIZE="18"><B>Stage C</B></FONT></TD></TR>
      <TR><TD BGCOLOR="#efeeea" STYLE="rounded"><FONT POINT-SIZE="14" COLOR="#0b0b0b">Short label</FONT></TD></TR>
    </TABLE>>];

  a -> b [label="  verb  "];
  b -> c   [label="  verb  "];

}
